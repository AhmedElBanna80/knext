{
  "_doc": "Each key names one counted quantity cited in an EGM.md as `N<!--egm:KEY-->`. kinds: entries (directory entries of one dir, filtered by `name` regex and `type` file|dir|any, `exclude` regex), grep (files in `dir` matching `name`, whose content matches `pattern`), json-keys (keys of the object at `path` in a JSON file that start with `prefix`).",
  "counts": {
    "scripts.entries": { "kind": "entries", "dir": "scripts", "type": "any" },
    "scripts.files": { "kind": "entries", "dir": "scripts", "type": "file" },
    "scripts.mjs": { "kind": "entries", "dir": "scripts", "type": "file", "name": "\\.mjs$" },
    "scripts.sh": { "kind": "entries", "dir": "scripts", "type": "file", "name": "\\.sh$" },
    "scripts.ts": { "kind": "entries", "dir": "scripts", "type": "file", "name": "\\.ts$" },
    "scripts.json": { "kind": "entries", "dir": "scripts", "type": "file", "name": "\\.json$" },
    "scripts.dirs": { "kind": "entries", "dir": "scripts", "type": "dir" },
    "scripts.provers": {
      "kind": "entries",
      "dir": "scripts",
      "type": "file",
      "name": "^mutation-prove-.*\\.mjs$"
    },
    "scripts.provers.prover-report": {
      "kind": "grep",
      "dir": "scripts",
      "name": "^mutation-prove-.*\\.mjs$",
      "pattern": "lib/prover-report"
    },
    "scripts.provers.mutation-harness": {
      "kind": "grep",
      "dir": "scripts",
      "name": "^mutation-prove-.*\\.mjs$",
      "pattern": "lib/mutation-harness"
    },
    "scripts.provers.guard-prover": {
      "kind": "grep",
      "dir": "scripts",
      "name": "^mutation-prove-.*\\.mjs$",
      "pattern": "lib/guard-prover"
    },
    "scripts.lib.files": {
      "kind": "entries",
      "dir": "scripts/lib",
      "type": "file",
      "exclude": "^EGM\\.md$"
    },
    "kn-next.src.files": {
      "kind": "entries",
      "dir": "packages/kn-next/src",
      "type": "file",
      "exclude": "^EGM\\.md$"
    },
    "kn-next.adapters-subpaths": {
      "kind": "json-keys",
      "file": "packages/kn-next/package.json",
      "path": "exports",
      "prefix": "./adapters/"
    },
    "kn-next-action.mjs": {
      "kind": "entries",
      "dir": "packages/kn-next-action",
      "type": "file",
      "name": "\\.mjs$"
    }
  }
}
